{
  "name": "balises",
  "version": "0.9.0",
  "description": "A very simple reactive html templating library",
  "author": "Julien Elbaz <elbywan@hotmail.com>",
  "type": "module",
  "keywords": [
    "html",
    "reactive",
    "template"
  ],
  "workspaces": [
    "bench",
    "bench-dom"
  ],
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./bundle": {
      "import": "./dist/balises.esm.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./signals": {
      "import": "./dist/esm/signals/index.js",
      "types": "./dist/esm/signals/index.d.ts"
    },
    "./signals/signal": {
      "import": "./dist/esm/signals/signal.js",
      "types": "./dist/esm/signals/signal.d.ts"
    },
    "./signals/computed": {
      "import": "./dist/esm/signals/computed.js",
      "types": "./dist/esm/signals/computed.d.ts"
    },
    "./signals/store": {
      "import": "./dist/esm/signals/store.js",
      "types": "./dist/esm/signals/store.d.ts"
    },
    "./signals/context": {
      "import": "./dist/esm/signals/context.js",
      "types": "./dist/esm/signals/context.d.ts"
    },
    "./template": {
      "import": "./dist/esm/template.js",
      "types": "./dist/esm/template.d.ts"
    },
    "./parser": {
      "import": "./dist/esm/parser.js",
      "types": "./dist/esm/parser.d.ts"
    },
    "./async": {
      "import": "./dist/esm/async.js",
      "types": "./dist/esm/async.d.ts"
    },
    "./each": {
      "import": "./dist/esm/each.js",
      "types": "./dist/esm/each.d.ts"
    },
    "./match": {
      "import": "./dist/esm/match.js",
      "types": "./dist/esm/match.d.ts"
    },
    "./memo": {
      "import": "./dist/esm/memo.js",
      "types": "./dist/esm/memo.d.ts"
    },
    "./ssr": {
      "import": "./dist/esm/ssr.js",
      "types": "./dist/esm/ssr.d.ts"
    },
    "./hydrate": {
      "import": "./dist/esm/hydrate.js",
      "types": "./dist/esm/hydrate.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && rolldown -c",
    "test": "node --import tsx/esm --import ./tests/setup.ts --test tests/*.test.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "yarn format && yarn lint:fix && yarn typecheck",
    "pretty": "prettier --write .",
    "examples": "yarn examples:build && yarn dlx serve examples",
    "examples:build": "rolldown -c examples/rolldown.config.ts && cp docs/base.css examples/ && cp docs/example.css examples/ && node --import tsx/esm examples/ssr/build-html.ts",
    "bench": "yarn workspace balises-benchmarks start --isolate",
    "bench:update-readme": "yarn workspace balises-benchmarks update-readme",
    "bench:self": "yarn workspace balises-benchmarks start:self --isolate",
    "bench:layers": "yarn workspace balises-benchmarks start:layers --isolate",
    "bench:wide": "yarn workspace balises-benchmarks start:wide --isolate",
    "bench:diamond": "yarn workspace balises-benchmarks start:diamond --isolate",
    "bench:create": "yarn workspace balises-benchmarks start:create --isolate",
    "bench:conditional": "yarn workspace balises-benchmarks start:conditional --isolate",
    "bench:list": "yarn workspace balises-benchmarks start:list --isolate",
    "bench-dom": "yarn build && yarn workspace balises-dom-benchmarks start",
    "bench-dom:build": "yarn build && yarn workspace balises-dom-benchmarks build",
    "bench-dom:run": "yarn workspace balises-dom-benchmarks build && node --import tsx/esm bench-dom/src/playwright-runner.ts",
    "bench-dom:quick": "yarn workspace balises-dom-benchmarks build && node --import tsx/esm bench-dom/src/playwright-runner.ts --quick",
    "bench-dom:check": "yarn bench-dom:run && node --import tsx/esm bench-dom/src/check-standings.ts",
    "docs": "yarn docs:build && yarn dlx serve _site",
    "docs:build": "yarn build && yarn examples:build && rm -rf _site && mkdir -p _site/assets && cp docs/index.html _site/ && cp docs/*.css _site/ && cp docs/*.js _site/ && cp assets/logo.svg _site/assets/ && cp assets/logo-icon.svg _site/assets/ && cp -r examples _site/examples && cp dist/balises.esm.js _site/examples/ && cp -r dist/esm _site/examples/balises-esm"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "rolldown": "1.2.1",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "balises": "workspace:."
  }
}
